# Settings and private data
.mcp.json
mikanBox/data/settings.json
mikanBox/data/mcp_key.txt
mikanBox/data/login_attempts.json

# User content: seeded at first run from import/{lang} (see
# lib/functions.php: bootstrapFreshInstallFromImport), not tracked directly.
# (trailing slash so this also covers nested pages, e.g. data/posts/coffee/)
mikanBox/data/posts/
mikanBox/data/components/*
!mikanBox/data/components/

# Media files
media/*
!media/.gitkeep

# Auto-generated files
/.htaccess
mikanBox/data/.htaccess
/sitemap.xml
/rss.xml
/podcast.xml

# System and temp files
*.log
.DS_Store
gomi/
.vscode/
.claude/
CLAUDE.md
